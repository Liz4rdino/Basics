
while True:
    try: 
        name = (input("Inform your name: "))
        if not name.replace(" ", "").isalpha():
            print ("Please, enter a valid name.")
        else:
            break
    except ValueError:
            print ("Try again. Make sure to enter the correct values.")

while True:
    try: 
        age = int(input("Inform your age: "))
        if age < 0 or age > 120:
            print ("Please, enter a valid age.")
        else:
            break
    except ValueError:
            print ("Try again. Make sure to enter the correct values.")

while True:
    try: 
        height = float(input("Inform your height: ").replace(",", "."))
        if height <= 0 or height >= 3:
            print ("Please, enter a valid height.")
        else:
            break
    except ValueError:
            print ("Try again. Make sure to enter the correct values.")
    
print (f"Your name is {name}, you are {age} years old and you are {height}m tall.")
print ("-" * 30)
print ("Variables Types")
print(type(name))
print(type(age))
print(type(height))

    
